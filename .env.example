# ── Backend Environment Variables (Render / Local) ───────────────────
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devora?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
GEMINI_API_KEY=your_google_gemini_api_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ── Frontend Environment Variables (Vercel / Local) ──────────────────
REACT_APP_API_URL=https://devora-backend.onrender.com
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
